# The website has no server of its own — it calls the ERP backend (../ERP).
#
# Development: leave VITE_API_URL empty. `npm run dev` proxies /api to the ERP
# at http://localhost:3100 (start it with `npm run dev` in ../ERP); set ERP_URL
# if it runs elsewhere.
#
# Production: build with the ERP's public origin, and add this site's origin to
# the ERP's ALLOWED_ORIGIN.
#   VITE_API_URL="https://erp.example.com"
VITE_API_URL=""

# Everything else the website used to need (GEMINI_API_KEY, SMTP_*, LEADS_EMAIL)
# now lives in the ERP's environment — see ../ERP/.env.example.
