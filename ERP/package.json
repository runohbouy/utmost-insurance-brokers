{
  "name": "utmost-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Utmost Insurance Brokers' insurance brokerage ERP — CRM, policy administration, claims, finance, compliance and workflow engine. System of record; the public quote-generator app calls this service's API.",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:migrate:all": "tsx database/migrate-all.ts",
    "db:down": "docker compose down",
    "db:migrate": "tsx database/migrate.ts",
    "db:migrate:insurer-settings": "tsx database/migrate-002-insurer-settings.ts",
    "db:migrate:insurer-classes": "tsx database/migrate-003-insurer-classes.ts",
    "db:migrate:statutory-levies": "tsx database/migrate-004-statutory-levies.ts",
    "db:migrate:commission-guide": "tsx database/migrate-005-commission-guide.ts",
    "db:migrate:auth-seed": "tsx database/migrate-006-auth-seed.ts",
    "db:migrate:policy-checking": "tsx database/migrate-007-policy-checking.ts",
    "db:migrate:claim-checklist-diary": "tsx database/migrate-008-claim-checklist-diary.ts",
    "db:migrate:claim-settlement": "tsx database/migrate-009-claim-settlement.ts",
    "db:migrate:market-strategy": "tsx database/migrate-010-market-strategy-appetite.ts",
    "db:migrate:claim-reserve-payment": "tsx database/migrate-011-claim-reserve-payment-priority.ts",
    "db:migrate:risk-clearance": "tsx database/migrate-012-risk-clearance.ts",
    "db:seed": "tsx database/seed.ts",
    "db:seed:insurers": "tsx database/seed-insurers.ts",
    "db:seed:showcase": "tsx database/seed-showcase.ts",
    "db:delete:showcase": "tsx database/delete-showcase.ts",
    "db:seed:bulk": "tsx database/seed-bulk.ts",
    "db:delete:bulk": "tsx database/delete-bulk.ts",
    "db:migrate:premium-finance": "tsx database/migrate-013-premium-finance.ts",
    "db:migrate:underwriting-claims": "tsx database/migrate-014-underwriting-claims.ts",
    "db:migrate:kyc-checklist": "tsx database/migrate-015-kyc-checklist.ts",
    "db:migrate:endorsement-taxonomy": "tsx database/migrate-016-endorsement-taxonomy.ts",
    "db:migrate:general-ledger": "tsx database/migrate-017-general-ledger.ts",
    "db:migrate:hr": "tsx database/migrate-018-hr.ts",
    "db:migrate:producers": "tsx database/migrate-019-producers.ts",
    "db:migrate:route-permissions": "tsx database/migrate-020-route-permissions.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@google/genai": "^2.31.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  }
}
