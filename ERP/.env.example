# DATABASE_URL: PostgreSQL connection string. Run `docker compose up -d`
# for a local dev database matching these defaults, then `npm run db:migrate`.
DATABASE_URL="postgresql://uib:uib_dev_password@localhost:5432/uib_ops"

# PGLITE_DEV: set to "true" only when using `npm run db:up:pglite`
# instead of Docker — caps the connection pool at 1 (see db/client.ts).
# Leave unset/"false" against real Postgres.
PGLITE_DEV="false"

# INTERNAL_API_KEY: shared secret for server-to-server calls (e.g. from
# the public quote-generator app). Sent as the `x-api-key` header.
# Generate a real one for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY="dev-only-change-me"

# ALLOWED_ORIGIN: origin permitted to call this API cross-origin — the
# quote-generator app (studio) calling from a different port.
ALLOWED_ORIGIN="http://localhost:3000"
# Comma-separated for more than one. REQUIRED when NODE_ENV=production —
# the server refuses to boot without it. In dev, any localhost port is
# also allowed.

# PRODUCTION: with NODE_ENV=production the server refuses to start unless
# JWT_SECRET and INTERNAL_API_KEY are both random values of 32+ characters
# (the "dev-only-change-me" placeholders are rejected).
#
# The x-api-key alone only reaches /parties and /policies (what the
# quote-generator needs). Every other route requires a staff login.

# JWT_SECRET: signs staff login tokens (POST /api/auth/login). Separate
# from INTERNAL_API_KEY — that gates which *application* may call this
# API at all; this identifies which *staff member* is behind a given
# dashboard request, for RBAC and audit-trail attribution. Generate a
# real one for anything beyond local dev, same as INTERNAL_API_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="dev-only-change-me-too"

# ---------------------------------------------------------------------------
# Website API (/api/site/*) — the public quote site (../studio) and its staff
# workspace. This used to be the studio app's own server; its settings live here now.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: powers the AI room analyser, insurance advisor chat and claims
# assistant. Unset, those features fall back to canned responses.
GEMINI_API_KEY=""

# SMTP_*: outbound email (lead notifications, OTP codes, claim intake) forwarded
# to LEADS_EMAIL. Any SMTP provider works. Leave unset in development: the server
# logs what it would have sent instead of failing the request.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Utmost Insurance Brokers <no-reply@utmostkenya.com>"
LEADS_EMAIL="info@utmostkenya.com"

# TRUST_PROXY: number of reverse-proxy hops in front of this server (Render, nginx...).
# Needed in production so the per-IP rate limits see the real client address.
# TRUST_PROXY="1"
